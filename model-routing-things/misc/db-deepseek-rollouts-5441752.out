n    62\t)\n    63\tfrom pandas._libs.tslibs.parsing cimport parse_datetime_string\n    64\tfrom pandas._libs.tslibs.timestamps cimport _Timestamp\n    65\tfrom pandas._libs.tslibs.timezones cimport (\n    66\t    get_utcoffset,\n    67\t    is_utc,\n    68\t)\n    69\tfrom pandas._libs.tslibs.tzconversion cimport (\n    70\t    Localizer,\n    71\t    tz_localize_to_utc_single,\n    72\t)\n    73\tfrom pandas._libs.tslibs.util cimport (\n    74\t    is_float_object,\n    75\t    is_integer_object,\n    76\t)\n    77\t\n    78\t# ----------------------------------------------------------------------\n    79\t# Constants\n    80\t\n    81\tDT64NS_DTYPE = np.dtype("M8[ns]")\n    82\tTD64NS_DTYPE = np.dtype("m8[ns]")\n    83\t\n    84\t\n    85\t# ----------------------------------------------------------------------\n    86\t# Unit Conversion Helpers\n    87\t\n    88\tcdef int64_t cast_from_unit(\n    89\t    object ts,\n    90\t    str unit,\n    91\t    NPY_DATETIMEUNIT out_reso=NPY_FR_ns\n    92\t) except? -1:\n    93\t    """\n    94\t    Return a casting of the unit represented to nanoseconds\n    95\t    round the fractional part of a float to our precision, p.\n    96\t\n    97\t    Parameters\n    98\t    ----------\n    99\t    ts : int, float, or None\n   100\t    unit : str\n   101\t\n   102\t    Returns\n   103\t    -------\n   104\t    int64_t\n   105\t    """\n   106\t    cdef:\n   107\t        int64_t m\n   108\t        int p\n   109\t        NPY_DATETIMEUNIT in_reso\n   110\t\n   111\t    if unit in ["Y", "M"]:\n   112\t        if is_float_object(ts) and not ts.is_integer():\n   113\t            # GH#47267 it is clear that 2 "M" corresponds to 1970-02-01,\n   114\t            #  but not clear what 2.5 "M" corresponds to, so we will\n   115\t            #  disallow that case.\n   116\t            raise ValueError(\n   117\t                f"Conversion of non-round float with unit={unit} "\n   118\t                "is ambiguous"\n   119\t            )\n   120\t        # GH#47266 go through np.datetime64 to avoid weird results e.g. with "Y"\n   121\t        #  and 150 we\'d get 2120-01-01 09:00:00\n   122\t        if is_float_object(ts):\n   123\t            ts = int(ts)\n   124\t        dt64obj = np.datetime64(ts, unit)\n   125\t        return get_datetime64_nanos(dt64obj, out_reso)\n   126\t\n   127\t    in_reso = abbrev_to_npy_unit(unit)\n   128\t    if out_reso < in_reso and in_reso != NPY_DATETIMEUNIT.NPY_FR_GENERIC:\n   129\t        # We will end up rounding (always *down*), so don\'t need the fractional\n   130\t        #  part of `ts`.\n   131\t        m, _ = precision_from_unit(out_reso, in_reso)\n   132\t        return (<int64_t>ts) // m\n   133\t\n   134\t    m, p = precision_from_unit(in_reso, out_reso)\n   135\t\n   136\t    # cast the unit, multiply base/frac separately\n   137\t    # to avoid precision issues from float -> int\n   138\t    try:\n   139\t        base = <int64_t>ts\n   140\t    except OverflowError as err:\n   141\t        raise OutOfBoundsDatetime(\n   142\t            f"cannot convert input {ts} with the unit \'{unit}\'"\n   143\t        ) from err\n   144\t\n   145\t    frac = ts - base\n   146\t    if p:\n   147\t        frac = round(frac, p)\n   148\t\n   149\t    try:\n   150\t        return <int64_t>(base * m) + <int64_t>(frac * m)\n   151\t    except OverflowError as err:\n   152\t        raise OutOfBoundsDatetime(\n   153\t            f"cannot convert input {ts} with the unit \'{unit}\'"\n   154\t        ) from err\n   155\t\n   156\t\n   157\tcpdef (int64_t, int) precision_from_unit(\n   158\t    NPY_DATETIMEUNIT in_reso,\n   159\t    NPY_DATETIMEUNIT out_reso=NPY_DATETIMEUNIT.NPY_FR_ns,\n   160\t):\n   161\t    """\n   162\t    Return a casting of the unit represented to nanoseconds + the precision\n   163\t    to round the fractional part.\n   164\t\n   165\t    Notes\n   166\t    -----\n   167\t    The caller is responsible for ensuring that the default value of "ns"\n   168\t    takes the place of None.\n   169\t    """\n   170\t    cdef:\n   171\t        int64_t m\n   172\t        int64_t multiplier\n   173\t        int p\n   174\t\n   175\t    if in_reso == NPY_DATETIMEUNIT.NPY_FR_GENERIC:\n   176\t        in_reso = NPY_DATETIMEUNIT.NPY_FR_ns\n   177\t    if in_reso == NPY_DATETIMEUNIT.NPY_FR_Y:\n   178\t        # each 400 years we have 97 leap years, for an average of 97/400=.2425\n   179\t        #  extra days each year. We get 31556952 by writing\n   180\t        #  3600*24*365.2425=31556952\n   181\t        multiplier = periods_per_second(out_reso)\n   182\t        m = multiplier * 31556952\n   183\t    elif in_reso == NPY_DATETIMEUNIT.NPY_FR_M:\n   184\t        # 2629746 comes from dividing the "Y" case by 12.\n   185\t        multiplier = periods_per_second(out_reso)\n   186\t        m = multiplier * 2629746\n   187\t    else:\n   188\t        # Careful: if get_conversion_factor raises, the exception does\n   189\t        #  not propagate, instead we get a warning about an ignored exception.\n   190\t        #  https://github.com/pandas-dev/pandas/pull/51483#discussion_r1115198951\n   191\t        m = get_conversion_factor(in_reso, out_reso)\n   192\t\n   193\t    p = <int>log10(m)  # number of digits in \'m\' minus 1\n   194\t    return m, p\n   195\t\n   196\t\n   197\tcdef int64_t get_datetime64_nanos(object val, NPY_DATETIMEUNIT reso) except? -1:\n   198\t    """\n   199\t    Extract the value and unit from a np.datetime64 object, then convert the\n   200\t    value to nanoseconds if necessary.\n   201\t    """\n   202\t    cdef:\n   203\t        npy_datetimestruct dts\n   204\t        NPY_DATETIMEUNIT unit\n   205\t        npy_datetime ival\n   206\t\n   207\t    ival = cnp.get_datetime64_value(val)\n   208\t    if ival == NPY_NAT:\n   209\t        return NPY_NAT\n   210\t\n   211\t    unit = get_datetime64_unit(val)\n   212\t\n   213\t    if unit != reso:\n   214\t        pandas_datetime_to_datetimestruct(ival, unit, &dts)\n   215\t        check_dts_bounds(&dts, reso)\n   216\t        ival = npy_datetimestruct_to_datetime(reso, &dts)\n   217\t\n   218\t    return ival\n   219\t\n   220\t\n   221\t# ----------------------------------------------------------------------\n   222\t# _TSObject Conversion\n   223\t\n   224\t# lightweight C object to hold datetime & int64 pair\n   225\tcdef class _TSObject:\n   226\t    # cdef:\n   227\t    #    npy_datetimestruct dts      # npy_datetimestruct\n   228\t    #    int64_t value               # numpy dt64\n   229\t    #    tzinfo tzinfo\n   230\t    #    bint fold\n   231\t    #    NPY_DATETIMEUNIT creso\n   232\t\n   233\t    def __cinit__(self):\n   234\t        # GH 25057. As per PEP 495, set fold to 0 by default\n   235\t        self.fold = 0\n   236\t        self.creso = NPY_FR_ns  # default value\n   237\t\n   238\t    cdef int64_t ensure_reso(self, NPY_DATETIMEUNIT creso, str val=None) except? -1:\n   239\t        if self.creso != creso:\n   240\t            try:\n   241\t                self.value = convert_reso(self.value, self.creso, creso, False)\n   242\t            except OverflowError as err:\n   243\t                if val is not None:\n   244\t                    raise OutOfBoundsDatetime(\n   245\t                        f"Out of bounds nanosecond timestamp: {val}"\n   246\t                    ) from err\n   247\t                raise OutOfBoundsDatetime from err\n   248\t\n   249\t            self.creso = creso\n   250\t        return self.value\n   251\t\n   252\t\n   253\tcdef _TSObject convert_to_tsobject(object ts, tzinfo tz, str unit,\n   254\t                                   bint dayfirst, bint yearfirst, int32_t nanos=0):\n   255\t    """\n   256\t    Extract datetime and int64 from any of:\n   257\t        - np.int64 (with unit providing a possible modifier)\n   258\t        - np.datetime64\n   259\t        - a float (with unit providing a possible modifier)\n   260\t        - python int or long object (with unit providing a possible modifier)\n   261\t        - iso8601 string object\n   262\t        - python datetime object\n   263\t        - another timestamp object\n   264\t\n   265\t    Raises\n   266\t    ------\n   267\t    OutOfBoundsDatetime : ts cannot be converted within implementation bounds\n   268\t    """\n   269\t    cdef:\n   270\t        _TSObject obj\n   271\t        NPY_DATETIMEUNIT reso\n   272\t\n   273\t    obj = _TSObject()\n   274\t\n   275\t    if isinstance(ts, str):\n   276\t        return convert_str_to_tsobject(ts, tz, unit, dayfirst, yearfirst)\n   277\t\n   278\t    if checknull_with_nat_and_na(ts):\n   279\t        obj.value = NPY_NAT\n   280\t    elif is_datetime64_object(ts):\n   281\t        reso = get_supported_reso(get_datetime64_unit(ts))\n   282\t        obj.creso = reso\n   283\t        obj.value = get_datetime64_nanos(ts, reso)\n   284\t        if obj.value != NPY_NAT:\n   285\t            pandas_datetime_to_datetimestruct(obj.value, reso, &obj.dts)\n   286\t    elif is_integer_object(ts):\n   287\t        try:\n   288\t            ts = <int64_t>ts\n   289\t        except OverflowError:\n   290\t            # GH#26651 re-raise as OutOfBoundsDatetime\n   291\t            raise OutOfBoundsDatetime(f"Out of bounds nanosecond timestamp {ts}")\n   292\t        if ts == NPY_NAT:\n   293\t            obj.value = NPY_NAT\n   294\t        else:\n   295\t            if unit is None:\n   296\t                unit = "ns"\n   297\t            in_reso = abbrev_to_npy_unit(unit)\n   298\t            reso = get_supported_reso(in_reso)\n   299\t            ts = cast_from_unit(ts, unit, reso)\n   300\t            obj.value = ts\n   301\t            obj.creso = reso\n   302\t            pandas_datetime_to_datetimestruct(ts, reso, &obj.dts)\n   303\t    elif is_float_object(ts):\n   304\t        if ts != ts or ts == NPY_NAT:\n   305\t            obj.value = NPY_NAT\n   306\t        else:\n   307\t            ts = cast_from_unit(ts, unit)\n   308\t            obj.value = ts\n   309\t            pandas_datetime_to_datetimestruct(ts, NPY_FR_ns, &obj.dts)\n   310\t    elif PyDateTime_Check(ts):\n   311\t        if nanos == 0:\n   312\t            if isinstance(ts, _Timestamp):\n   313\t                reso = (<_Timestamp>ts)._creso\n   314\t            else:\n   315\t                # TODO: what if user explicitly passes nanos=0?\n   316\t                reso = NPY_FR_us\n   317\t        else:\n   318\t            reso = NPY_FR_ns\n   319\t        return convert_datetime_to_tsobject(ts, tz, nanos, reso=reso)\n   320\t    elif PyDate_Check(ts):\n   321\t        # Keep the converter same as PyDateTime\'s\n   322\t        # For date object we give the lowest supported resolution, i.e. "s"\n   323\t        ts = datetime.combine(ts, time())\n   324\t        return convert_datetime_to_tsobject(\n   325\t            ts, tz, nanos=0, reso=NPY_DATETIMEUNIT.NPY_FR_s\n   326\t        )\n   327\t    else:\n   328\t        from .period import Period\n   329\t        if isinstance(ts, Period):\n   330\t            raise ValueError("Cannot convert Period to Timestamp "\n   331\t                             "unambiguously. Use to_timestamp")\n   332\t        raise TypeError(f"Cannot convert input [{ts}] of type {type(ts)} to "\n   333\t                        f"Timestamp")\n   334\t\n   335\t    maybe_localize_tso(obj, tz, obj.creso)\n   336\t    return obj\n   337\t\n   338\t\n   339\tcdef maybe_localize_tso(_TSObject obj, tzinfo tz, NPY_DATETIMEUNIT reso):\n   340\t    if tz is not None:\n   341\t        _localize_tso(obj, tz, reso)\n   342\t\n   343\t    if obj.value != NPY_NAT:\n   344\t        # check_overflows needs to run after _localize_tso\n   345\t        check_dts_bounds(&obj.dts, reso)\n   346\t        check_overflows(obj, reso)\n   347\t\n   348\t\n   349\tcdef _TSObject convert_datetime_to_tsobject(\n   350\t    datetime ts,\n   351\t    tzinfo tz,\n   352\t    int32_t nanos=0,\n   353\t    NPY_DATETIMEUNIT reso=NPY_FR_ns,\n   354\t):\n   355\t    """\n   356\t    Convert a datetime (or Timestamp) input `ts`, along with optional timezone\n   357\t    object `tz` to a _TSObject.\n   358\t\n   359\t    The optional argument `nanos` allows for cases where datetime input\n   360\t    needs to be supplemented with higher-precision information.\n   361\t\n   362\t    Parameters\n   363\t    ----------\n   364\t    ts : datetime or Timestamp\n   365\t        Value to be converted to _TSObject\n   366\t    tz : tzinfo or None\n   367\t        timezone for the timezone-aware output\n   368\t    nanos : int32_t, default is 0\n   369\t        nanoseconds supplement the precision of the datetime input ts\n   370\t    reso : NPY_DATETIMEUNIT, default NPY_FR_ns\n   371\t\n   372\t    Returns\n   373\t    -------\n   374\t    obj : _TSObject\n   375\t    """\n   376\t    cdef:\n   377\t        _TSObject obj = _TSObject()\n   378\t        int64_t pps\n   379\t\n   380\t    obj.creso = reso\n   381\t    obj.fold = ts.fold\n   382\t    if tz is not None:\n   383\t\n   384\t        if ts.tzinfo is not None:\n   385\t            # Convert the current timezone to the passed timezone\n   386\t            ts = ts.astimezone(tz)\n   387\t            pydatetime_to_dtstruct(ts, &obj.dts)\n   388\t            obj.tzinfo = ts.tzinfo\n   389\t        elif not is_utc(tz):\n   390\t            ts = _localize_pydatetime(ts, tz)\n   391\t            pydatetime_to_dtstruct(ts, &obj.dts)\n   392\t            obj.tzinfo = ts.tzinfo\n   393\t        else:\n   394\t            # UTC\n   395\t            pydatetime_to_dtstruct(ts, &obj.dts)\n   396\t            obj.tzinfo = tz\n   397\t    else:\n   398\t        pydatetime_to_dtstruct(ts, &obj.dts)\n   399\t        obj.tzinfo = ts.tzinfo\n   400\t\n   401\t    if isinstance(ts, ABCTimestamp):\n   402\t        obj.dts.ps = ts.nanosecond * 1000\n   403\t\n   404\t    if nanos:\n   405\t        obj.dts.ps = nanos * 1000\n   406\t\n   407\t    obj.value = npy_datetimestruc