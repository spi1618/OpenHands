j.creso)\n   458\t    check_overflows(obj, obj.creso)\n   459\t\n   460\t\n   461\tcdef _TSObject convert_str_to_tsobject(str ts, tzinfo tz, str unit,\n   462\t                                       bint dayfirst=False,\n   463\t                                       bint yearfirst=False):\n   464\t    """\n   465\t    Convert a string input `ts`, along with optional timezone object`tz`\n   466\t    to a _TSObject.\n   467\t\n   468\t    The optional arguments `dayfirst` and `yearfirst` are passed to the\n   469\t    dateutil parser.\n   470\t\n   471\t    Parameters\n   472\t    ----------\n   473\t    ts : str\n   474\t        Value to be converted to _TSObject\n   475\t    tz : tzinfo or None\n   476\t        timezone for the timezone-aware output\n   477\t    unit : str or None\n   478\t    dayfirst : bool, default False\n   479\t        When parsing an ambiguous date string, interpret e.g. "3/4/1975" as\n   480\t        April 3, as opposed to the standard US interpretation March 4.\n   481\t    yearfirst : bool, default False\n   482\t        When parsing an ambiguous date string, interpret e.g. "01/05/09"\n   483\t        as "May 9, 2001", as opposed to the default "Jan 5, 2009"\n   484\t\n   485\t    Returns\n   486\t    -------\n   487\t    obj : _TSObject\n   488\t    """\n   489\t    cdef:\n   490\t        npy_datetimestruct dts\n   491\t        int out_local = 0, out_tzoffset = 0, string_to_dts_failed\n   492\t        datetime dt\n   493\t        int64_t ival\n   494\t        NPY_DATETIMEUNIT out_bestunit, reso\n   495\t        _TSObject obj\n   496\t\n   497\t    if len(ts) == 0 or ts in nat_strings:\n   498\t        obj = _TSObject()\n   499\t        obj.value = NPY_NAT\n   500\t        obj.tzinfo = tz\n   501\t        return obj\n   502\t    elif ts == "now":\n   503\t        # Issue 9000, we short-circuit rather than going\n   504\t        # into np_datetime_strings which returns utc\n   505\t        dt = datetime.now(tz)\n   506\t    elif ts == "toda